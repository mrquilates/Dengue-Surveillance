rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the caller is authenticated
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Helper function to check if the user is accessing their own documents
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper to validate string IDs
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Root user document rule
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // User's saved investigations
      match /investigations/{investigationId} {
        allow read, write: if isOwner(userId) && isValidId(investigationId);
      }

      // User's custom intervention milestones
      match /interventions/{interventionId} {
        allow read, write: if isOwner(userId) && isValidId(interventionId);
      }

      // User's saved datasets
      match /datasets/{datasetId} {
        allow read, write: if isOwner(userId) && isValidId(datasetId);
      }
    }

    // Connectivity test path for verification
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
